# Copy to .env for local development. .env is gitignored.
DATABASE_URL=postgresql+psycopg://manguito:manguito@localhost:5433/manguito
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=local
# Google OAuth. Register both the localhost and production redirect URIs on
# one client in the Google Cloud console; Google allows plain http for
# localhost specifically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
APP_URL=http://localhost:5173
# Empty locally. Set to .<domain> in production so the cookie is shared
# between app.<domain> and api.<domain>.
SESSION_COOKIE_DOMAIN=
# Envelope encryption. Generate one with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Format is a comma separated list of version:base64 pairs, so a rotation
# keeps the retired key available to unwrap rows that still name it.
SECRETS_KEKS=1:
SECRETS_KEK_VERSION=1
